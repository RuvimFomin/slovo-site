---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getEventPages, eventStart, type EventEntry } from "../../lib/events";
import { formatDateFull } from "../../lib/format";
import { u } from "../../lib/url";
import { site } from "../../data/site";

export async function getStaticPaths() {
  const events = await getEventPages();
  return events.map((event) => ({ params: { slug: event.id }, props: { event } }));
}

interface Props {
  event: EventEntry;
}

const { event } = Astro.props;

const all = await getCollection("events");
const now = new Date();
const byStart = (a: EventEntry, b: EventEntry) =>
  eventStart(a).getTime() - eventStart(b).getTime();
const upcoming = all
  .filter((e) => e.data.status === "published" && eventStart(e) >= now)
  .sort(byStart);
const past = all
  .filter((e) => e.data.status !== "draft" && eventStart(e) < now)
  .sort((a, b) => byStart(b, a));
---

<Base
  title="Афиша встреч — СЛОВО"
  description="Все встречи пространства «СЛОВО»: анонсы предстоящих лекций и архив прошедших. Каждое воскресенье в 16:00, Москва, Тверская, 15."
>
  <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
    <h1 class="font-display text-4xl text-navy">Афиша встреч</h1>
    <p class="mt-4 text-ink/70">
      Встречаемся каждое воскресенье в 16:00 по адресу: {site.address}.
    </p>

    <h2 class="mt-12 font-display text-2xl text-navy">Предстоящие</h2>
    {
      upcoming.length > 0 ? (
        <ul class="mt-6 space-y-4">
          {upcoming.map((e) => (
            <li>
              <a
                href={u(`/events/${e.id}/`)}
                class="block rounded-2xl border border-ink/10 bg-white p-6 transition-shadow hover:shadow-md"
              >
                <p class="text-sm text-ink/50">
                  {formatDateFull(e.data.date)}, {e.data.startTime}
                </p>
                <p class="mt-1 font-display text-xl text-navy">
                  {e.data.number && `Встреча №${e.data.number}. `}{e.data.title}
                </p>
                <p class="mt-2 line-clamp-2 text-sm text-ink/70">{e.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 rounded-2xl border border-dashed border-ink/20 p-8 text-center text-ink/60">
          Программа ближайшей встречи готовится.
        </p>
      )
    }

    <h2 class="mt-14 font-display text-2xl text-navy">Архив</h2>
    {
      past.length > 0 ? (
        <ul class="mt-6 space-y-4">
          {past.map((e) => (
            <li>
              <a
                href={u(`/events/${e.id}/`)}
                class="block rounded-2xl border border-ink/10 bg-white/60 p-6 transition-shadow hover:shadow-md"
              >
                <p class="text-sm text-ink/50">{formatDateFull(e.data.date)}</p>
                <p class="mt-1 font-display text-xl text-navy">
                  {e.data.number && `Встреча №${e.data.number}. `}{e.data.title}
                </p>
                {e.data.videoUrls?.youtube && (
                  <p class="mt-2 text-sm font-medium text-navy">Есть видеозапись</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-6 text-ink/60">Архив пока пуст.</p>
      )
    }
  </div>
</Base>
