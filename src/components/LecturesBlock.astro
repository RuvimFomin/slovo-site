---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/format";
import { site } from "../data/site";

interface Props {
  lectures: CollectionEntry<"lectures">[];
  speakerNames: Record<string, string>;
}

const { lectures, speakerNames } = Astro.props;
---

<section id="lectures" class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl text-navy sm:text-4xl">Записи лекций</h2>
        <p class="mt-4 text-ink/70">
          Если не получилось прийти — смотрите записи на нашем YouTube-канале.
        </p>
      </div>
      <a
        href={site.socials.youtube}
        target="_blank"
        rel="noopener"
        data-goal="click_youtube"
        class="font-medium text-navy underline underline-offset-4 hover:text-gold"
      >
        Все записи на YouTube
      </a>
    </div>

    {
      lectures.length > 0 ? (
        <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {lectures.map((lecture) => {
            const goalParams = JSON.stringify({ lecture_id: lecture.id });
            return (
              <li
                class="flex flex-col rounded-2xl border border-ink/10 bg-paper p-6"
                data-goal-view="view_lecture"
                data-goal-params={goalParams}
              >
                <p class="text-sm text-ink/50">{formatDate(lecture.data.date)}</p>
                <h3 class="mt-2 font-display text-xl leading-snug text-navy">
                  {lecture.data.title}
                </h3>
                <p class="mt-2 text-sm text-ink/60">
                  {speakerNames[lecture.data.speakerId] ?? ""}
                  {lecture.data.bibleReference && ` · ${lecture.data.bibleReference}`}
                </p>
                {lecture.data.description && (
                  <p class="mt-3 line-clamp-3 text-sm text-ink/70">{lecture.data.description}</p>
                )}
                {lecture.data.videoUrl && (
                  <a
                    href={lecture.data.videoUrl}
                    target="_blank"
                    rel="noopener"
                    data-goal="play_video"
                    data-goal-params={goalParams}
                    class="mt-4 inline-flex items-center gap-2 pt-2 text-sm font-medium text-navy hover:text-gold"
                  >
                    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                      <circle cx="9" cy="9" r="8" stroke="currentColor" stroke-width="1.5" />
                      <path d="M7 5.5v7l6-3.5-6-3.5z" fill="currentColor" />
                    </svg>
                    Смотреть запись
                  </a>
                )}
              </li>
            );
          })}
        </ul>
      ) : (
        <p class="mt-10 rounded-2xl border border-dashed border-ink/20 p-8 text-center text-ink/60">
          Записи скоро появятся. Следите за обновлениями в нашем Telegram-канале.
        </p>
      )
    }
  </div>
</section>
