---
import { site } from "../data/site";
---

<section id="location" class="bg-sand/40">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl text-navy sm:text-4xl">Как нас найти</h2>
        <p class="mt-5 text-xl font-medium text-navy">{site.address}</p>
        <p class="mt-2 text-ink/70">
          Ближайшее метро: {site.metro.join(", ")}.
        </p>
        <p class="mt-4 leading-relaxed text-ink/75">{site.directions}</p>

        <a
          href={site.routeUrl}
          target="_blank"
          rel="noopener"
          data-goal="click_route"
          class="mt-7 inline-flex items-center gap-2 rounded-full bg-navy px-7 py-3.5 font-medium text-white transition-colors hover:bg-navy-light"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M9 16.5s6-4.9 6-9.75A6 6 0 1 0 3 6.75C3 11.6 9 16.5 9 16.5z" stroke="currentColor" stroke-width="1.5" />
            <circle cx="9" cy="6.75" r="2.25" stroke="currentColor" stroke-width="1.5" />
          </svg>
          Построить маршрут
        </a>

        <p class="mt-4 text-sm text-ink/50">
          Ссылка ведёт на построение маршрута к адресу в Яндекс Картах.
        </p>
      </div>

      <!-- TODO: добавить фотографию входа и пошаговую инструкцию по проходу -->
      <div class="flex items-center justify-center rounded-3xl border border-dashed border-ink/20 bg-white/50 p-10 text-center text-ink/50">
        Здесь будет фотография входа<br />и схема прохода
      </div>
    </div>
  </div>
</section>
