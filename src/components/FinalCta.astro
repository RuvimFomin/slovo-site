---
import type { EventEntry } from "../lib/events";
import { formatDate } from "../lib/format";
import { site } from "../data/site";

interface Props {
  event?: EventEntry;
}

const { event } = Astro.props;
const goalParams = event
  ? JSON.stringify({ event_id: event.id, event_title: event.data.title })
  : "{}";
---

<section class="bg-navy text-white">
  <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6">
    <h2 class="font-display text-3xl sm:text-4xl">Приходите в ближайшее воскресенье</h2>
    {
      event ? (
        <p class="mt-4 text-lg text-white/85">
          {formatDate(event.data.date)}, {event.data.startTime} · {event.data.title} · {site.address}
        </p>
      ) : (
        <p class="mt-4 text-lg text-white/85">
          Каждое воскресенье, 16:00 · {site.address}
        </p>
      )
    }
    <div class="mt-8">
      {
        event?.data.registrationUrl ? (
          <a
            href={event.data.registrationUrl}
            target="_blank"
            rel="noopener"
            data-utm
            data-goal="click_registration"
            data-goal-params={goalParams}
            class="inline-block rounded-full bg-white px-8 py-4 font-medium text-navy transition-colors hover:bg-sand hover:text-navy"
          >
            {event.data.isFree ? "Зарегистрироваться бесплатно" : "Зарегистрироваться"}
          </a>
        ) : (
          <a
            href={site.socials.telegram}
            target="_blank"
            rel="noopener"
            data-goal="click_telegram"
            class="inline-block rounded-full bg-white px-8 py-4 font-medium text-navy transition-colors hover:bg-sand hover:text-navy"
          >
            Следить за анонсами в Telegram
          </a>
        )
      }
    </div>
  </div>
</section>
