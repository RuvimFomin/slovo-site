---
import { site } from "../data/site";

const channels = [
  {
    name: "Telegram",
    url: site.socials.telegram,
    goal: "click_telegram",
    text: "Анонсы встреч, программа и новости пространства.",
  },
  {
    name: "YouTube",
    url: site.socials.youtube,
    goal: "click_youtube",
    text: "Записи лекций и фрагменты культурной программы.",
  },
  {
    name: "Timepad",
    url: site.socials.timepad,
    goal: undefined,
    text: "Полная афиша встреч и регистрация.",
  },
  {
    name: "Taplink",
    url: site.socials.taplink,
    goal: undefined,
    text: "Все наши площадки в одном месте.",
  },
];
---

<section id="contacts" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <h2 class="font-display text-3xl text-navy sm:text-4xl">Контакты и социальные сети</h2>

  <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {channels.map((ch) => (
      <a
        href={ch.url}
        target="_blank"
        rel="noopener"
        data-goal={ch.goal}
        class="group rounded-2xl border border-ink/10 bg-white p-6 transition-shadow hover:shadow-md"
      >
        <p class="font-display text-xl text-navy group-hover:text-gold">{ch.name}</p>
        <p class="mt-2 text-sm leading-relaxed text-ink/65">{ch.text}</p>
      </a>
    ))}
  </div>

  <p class="mt-8 text-ink/70">
    По вопросам: <a href={`mailto:${site.contactEmail}`} data-goal="click_contact" class="font-medium text-navy underline underline-offset-4 hover:text-gold">{site.contactEmail}</a>
  </p>
</section>
