---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import fallbackPhoto from "../assets/photos/vstrecha-1.jpeg";

interface Props {
  speaker: CollectionEntry<"speakers">;
}

const { speaker } = Astro.props;
const { name, role, bio, photo, links } = speaker.data;
---

<section id="speaker" class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
  <div class="grid items-center gap-10 lg:grid-cols-[2fr_3fr]">
    <div class="overflow-hidden rounded-3xl">
      <Image
        src={photo ?? fallbackPhoto}
        alt={photo ? `Фотография: ${name}` : `${name} выступает с лекцией в пространстве «СЛОВО»`}
        widths={[500, 800, 1200]}
        sizes="(min-width: 1024px) 33vw, 100vw"
        class="aspect-[4/5] w-full object-cover"
      />
    </div>
    <div>
      <p class="text-sm font-medium uppercase tracking-[0.2em] text-gold">Лектор основного цикла</p>
      <h2 class="mt-3 font-display text-3xl text-navy sm:text-4xl">{name}</h2>
      <p class="mt-2 font-medium text-ink/60">{role}</p>
      <p class="mt-5 leading-relaxed text-ink/80">{bio}</p>
      {links.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-4">
          {links.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener" class="font-medium text-navy underline underline-offset-4 hover:text-gold">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
