---
import { Image } from "astro:assets";
import p1 from "../assets/photos/vstrecha-1.jpeg";
import p2 from "../assets/photos/vstrecha-2.jpeg";
import p3 from "../assets/photos/vstrecha-3.jpeg";
import p4 from "../assets/photos/vstrecha-4.jpeg";
import p5 from "../assets/photos/vstrecha-5.jpeg";
import p6 from "../assets/photos/vstrecha-6.jpeg";
import p7 from "../assets/photos/vstrecha-7.jpeg";
import p8 from "../assets/photos/vstrecha-8.jpeg";

// TODO: подписать даты и названия конкретных встреч, когда будут утверждены.
const photos = [
  { src: p1, alt: "Лектор выступает перед залом в пространстве «СЛОВО»", caption: "Открытая лекция" },
  { src: p3, alt: "Слушатели на лекции на фоне картин и кирпичных стен лофта", caption: "Атмосфера встреч" },
  { src: p8, alt: "Участники обсуждают тему встречи, сидя в кругу", caption: "Живой диалог" },
  { src: p2, alt: "Слушатели внимательно слушают лекцию", caption: "Аудитория" },
  { src: p4, alt: "Общение после лекции у книжного стола", caption: "После лекции" },
  { src: p6, alt: "Фуршет: гости общаются за столом с угощениями", caption: "Фуршет" },
  { src: p5, alt: "Гости разговаривают на фуршете после встречи", caption: "Новые знакомства" },
  { src: p7, alt: "Небольшая группа участников в обсуждении", caption: "Обсуждения" },
];
---

<section id="meetings" class="bg-navy text-white">
  <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="max-w-2xl">
      <h2 class="font-display text-3xl sm:text-4xl">Наши встречи</h2>
      <p class="mt-4 text-white/70">
        Реальные фотографии с прошедших встреч — лекции, искусство, общение и фуршет.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      {photos.map((photo, i) => (
        <figure class:list={["group relative overflow-hidden rounded-2xl", i % 5 === 0 && "col-span-2 row-span-2"]}>
          <Image
            src={photo.src}
            alt={photo.alt}
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 25vw, 50vw"
            class="aspect-square h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy/90 to-transparent px-4 pb-3 pt-10 text-sm text-white/90 opacity-0 transition-opacity group-hover:opacity-100">
            {photo.caption}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
